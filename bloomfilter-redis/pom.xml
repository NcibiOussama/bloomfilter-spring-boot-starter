<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ncibioussama</groupId>
        <artifactId>bloomfilter-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>bloomfilter-redis</artifactId>
    <name>Bloom Filter Redis Backend</name>
    <description>Distributed Bloom filter backed by a Redis bitmap, using atomic Lua scripts.</description>

    <properties>
        <automatic.module.name>io.github.ncibioussama.bloomfilter.redis</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.ncibioussama</groupId>
            <artifactId>bloomfilter-core</artifactId>
        </dependency>
        <!-- Optional: the backend only activates when the application already uses Spring Data Redis. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>${testcontainers-junit.artifactId}</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
