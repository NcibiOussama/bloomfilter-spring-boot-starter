<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ncibioussama</groupId>
        <artifactId>bloomfilter-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- The one dependency users add. Contains no code, only dependencies. -->
    <artifactId>bloomfilter-spring-boot-starter</artifactId>
    <name>Bloom Filter Spring Boot Starter</name>
    <description>Starter for secure, observable, declarative Bloom filters in Spring Boot.</description>

    <properties>
        <automatic.module.name>io.github.ncibioussama.bloomfilter.starter</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ncibioussama</groupId>
            <artifactId>bloomfilter-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ncibioussama</groupId>
            <artifactId>bloomfilter-core</artifactId>
        </dependency>
        <!-- Ships the Redis backend classes; Spring Data Redis itself stays optional
             and is only used when the application adds spring-boot-starter-data-redis. -->
        <dependency>
            <groupId>io.github.ncibioussama</groupId>
            <artifactId>bloomfilter-redis</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Maven Central requires -sources and -javadoc jars even for code-less modules. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>empty-sources-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.basedir}/src/release</classesDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>empty-javadoc-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}/src/release</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
